# Endereço do backend Spring, sem /api no final (as rotas já incluem /api).
# Também libera essa origem no connect-src da CSP do build. Padrão: http://localhost:8080
VITE_API_URL=http://localhost:8080

# Login de teste (só funciona em `npm run dev`).
# Copie este arquivo para .env.development.local (carregado pelo Vite apenas em dev) e defina usuário/senha.
VITE_DEV_USER=
VITE_DEV_PASS=
